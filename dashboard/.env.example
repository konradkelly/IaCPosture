# Point at the deployed review-api HTTP API base URL (no trailing slash).
# After `terraform apply`:
#   terraform output -raw review_api_endpoint
VITE_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com

# Cognito Hosted UI, from the same `terraform apply`:
#   terraform output -raw cognito_hosted_ui_domain
#   terraform output -raw cognito_dashboard_client_id
VITE_COGNITO_DOMAIN=xxxxxxxx.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
